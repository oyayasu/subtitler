{
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "icons/document.ico": "document.ico",
      "youtube-tools/": "youtube-tools/"
    }
  },
  "build": {
    "beforeBuildCommand": "python scripts/prepare_youtube_tools.py"
  }
}
